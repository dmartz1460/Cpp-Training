# This file contains configuration variables used to set up and run the Docker environment for this project. 
#
# Functionality:
#     - These variables are loaded by Docker Compose to configure services, credentials, and runtime behavior.
#
# Prerequisites:
#     - This script assumes that the build environment has already been set up.
#
# Usage:
#     - This file is automatically loaded by Docker Compose. Use environment variables or secrets management 
#       for secure handling of sensitive data.

#  Note:
#     -  Do not commit sensitive credentials to version control. 

# Define paths needed for building the docker image
CONTEXT_PATH=./..
DOCKERFILE_PATH=./docker/Dockerfile

# Define the default script command
BUILD_SCRIPT_COMMAND=./scripts/build.sh
ENTRYPOINT_SCRIPT_COMMAND=./scripts/entrypoint.sh

# Define the default docker name, user id, and group id. The ids should match your local ids to avoid permissions errors
USER_ID=1000
GROUP_ID=1000
USER_NAME=docker

# Define default paths for both the local host and docker container
HOST_PATH=./../
CONT_PATH=/home/${USER_NAME}